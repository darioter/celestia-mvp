{
  "buildCommand": "node tools/check-scripts.js",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/login",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://www.chefprivado.ar/management/login",
      "permanent": false
    },
    {
      "source": "/guia-gracias.html",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://www.chefprivado.ar/management/guia/gracias",
      "permanent": false
    },
    {
      "source": "/guia/gracias",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://www.chefprivado.ar/management/guia/gracias",
      "permanent": false
    },
    {
      "source": "/guia.html",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://www.chefprivado.ar/management/guia",
      "permanent": false
    },
    {
      "source": "/guia",
      "has": [
        {
          "type": "host",
