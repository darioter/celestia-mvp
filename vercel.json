    {
      "source": "/:c(curso0[1-3])",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://www.chefprivado.ar/management/:c",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://metodofermento.vercel.app/admin",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?metodofermento\\.com\\.ar"
        }
      ],
      "destination": "https://www.chefprivado.ar/management",
      "permanent": false
    },
    {
      "source": "/fermento",
      "destination": "/management",
      "permanent": true
    },
    {
      "source": "/metodofermento",
      "destination": "/management",
      "permanent": true
    },
    {
      "source": "/metodo-fermento",
      "destination": "/management",
      "permanent": true
    },
    {
      "source": "/fiestas",
      "destination": "/cajas",
      "permanent": false
    },
    {
      "source": "/mesa",
      "destination": "/?utm_source=qr&utm_medium=tarjeta&utm_campaign=mesa",
      "permanent": false
    },
    {
      "source": "/opinion",
      "destination": "https://g.page/r/CWYAy7Wn5FfhEBM/review",
      "permanent": false
    },
    {
      "source": "/review",
      "destination": "https://g.page/r/CWYAy7Wn5FfhEBM/review",
      "permanent": false
    },
    {
      "source": "/reseña",
      "destination": "https://g.page/r/CWYAy7Wn5FfhEBM/review",
      "permanent": false
    },
    {
      "source": "/resena",
      "destination": "https://g.page/r/CWYAy7Wn5FfhEBM/review",
      "permanent": false
    },
    {
      "source": "/index-beta.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/beta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-beta-export.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-original-temp.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ARCHIVOS SEGURIDAD/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin-historias",
      "destination": "/admin-historias.html"
    }
